rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    match /orders/{orderId} {
      // Allow read so order lookup (OrderLookupView) and admin panel can view orders
      allow read: if true;
      
      // Allow creating orders with valid format
      allow create: if request.resource.data.id is string
                    && request.resource.data.mcUsername is string
                    && request.resource.data.email is string;
      
      // Allow updates to order status and notes
      allow update: if true;
      
      // Allow order deletion by administration
      allow delete: if true;
    }
  }
}
