rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Orders collection: read, create, update, delete
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Store settings (IP, payments, store name, exchange rate, announcements)
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Persistent catalog, coupons, staff users, metadata
    match /store_data/{docId} {
      allow read, write: if true;
    }
  }
}
